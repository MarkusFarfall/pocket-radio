# Локальная разработка по умолчанию использует локальные аккаунты.
# Чтобы тестировать облачные аккаунты: VITE_AUTH_PROVIDER=supabase
VITE_AUTH_PROVIDER=local

# Необязательные данные вашего Supabase-проекта (перекрывают встроенные production defaults).
# Оставьте пустыми для локальной разработки.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
