# Облачные аккаунты Supabase. Без этих переменных работают локальные аккаунты (IndexedDB).
# Берётся из Project Settings → API: Project URL и anon public key.
# На Vercel задайте те же имена в Environment Variables проекта pocket-radio.
# Подробности: supabase/README.md
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
